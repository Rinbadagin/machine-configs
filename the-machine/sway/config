include /etc/nixos/sway/base-config
input "type:touchpad" {
  dwt disabled
    dwtp disabled
    tap enabled
    tap_button_map lrm
}

input "type:tablet_tool" {
  #map_to_region 0 0 1000 1000
  map_to_output eDP-1
}

# output eDP-1 {
